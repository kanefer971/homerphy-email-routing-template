{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "homerphy-email-routing-template",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"upload_source_maps": true,
	"assets": {
		"binding": "ASSETS",
		"directory": "./public",
		"run_worker_first": ["/"]
	},
	"vars": {
		"ROUTE_ADDRESS": "support@homerphy.fr",
		"FORWARD_TO": "fbrute@gmail.com",
		"ALLOWED_SENDERS": "tp41@homerphy.fr,tp42@homerphy.fr,tp43@homerphy.fr,tp44@homerprhy.fr,tp45@homerphy.fr,tp46@homerphy.fr,tp47@homerphy.fr,tp48@homerphy.fr,tp49@homerphy.fr,tp50@homerphy.fr,"
	},
	// Uncomment this top-level section after replacing the example address.
	// Each entry creates an Email Routing rule managed by Wrangler.
	// "addresses": [
	// 	"support@company.example"
	// 	// Use "*@company.example" instead to route every unmatched address.
	// ],
	"observability": {
		"enabled": true
	}
}
